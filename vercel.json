{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/page.js": {
      "includeFiles": "public/capture/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!assets/|capture/|replica\\.|api/).*)",
      "destination": "/api/page?route=/:path"
    }
  ]
}